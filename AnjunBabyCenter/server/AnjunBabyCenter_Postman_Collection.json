  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/users/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.hash && jsonData.expiry) {",
                  "    pm.collectionVariables.set(\"otpHash\", jsonData.hash);",
                  "    pm.collectionVariables.set(\"otpExpiry\", jsonData.expiry);",
                  "    console.log(\"OTP Hash and Expiry updated automatically!\");",
                  "}",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
