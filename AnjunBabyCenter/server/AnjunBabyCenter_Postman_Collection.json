          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken || jsonData.token) {",
                  "    var token = jsonData.accessToken || jsonData.token;",
                  "    pm.collectionVariables.set(\"token\", token);",
                  "    console.log(\"Token updated automatically!\");",
